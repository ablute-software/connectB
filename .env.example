# --- Supabase (Phase: connect the real database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public app URL ---
# Canonical base for links generated FOR users (invite accept, Stripe
# checkout/portal return). Set to https://sherlockdeal.com after the domain is
# pointed at this Vercel project — the cutover is this env change + a redeploy.
# Falls back to the current Vercel URL when unset.
NEXT_PUBLIC_APP_URL=

# --- Email sending (Phase 5) ---
# Transactional mail (confirmations, invites, magic links) sends from the
# platform address via Resend — not from SENDER_EMAIL below.
RESEND_API_KEY=
# Verified Resend sender for transactional mail, e.g. "Sherlock Deal Support <support@sherlockdeal.com>".
# Optional: overrides the default display name + verified address (env-gated switch).
# Falls back to Resend's own onboarding@resend.dev sender (works without domain verification, low deliverability) if unset.
# Set this to the real domain sender the moment sherlockdeal.com is verified in Resend (SPF/DKIM/DMARC) — see DECISIONS.md.
RESEND_FROM_EMAIL=
# Where replies to transactional mail should land — NOT authenticated by SPF/
# DKIM, so this can point at any address today (e.g. sherlockdeal.com@gmail.com)
# with zero domain verification. This is what makes "replies reach the inbox
# Nuno reads" true right now, independent of RESEND_FROM_EMAIL's state.
RESEND_REPLY_TO=
# Prompt 557 §3 — the signing secret for Resend's delivery webhook, shown
# once when the endpoint is created in the Resend dashboard (point it at
# https://<app>/api/resend/webhook and subscribe email.delivered,
# email.bounced, email.complained, email.delivery_delayed). Without it the
# webhook route rejects every request rather than trusting an unsigned one,
# so email_send_log.status can never move past 'sent' — which is exactly the
# state that made six accepted-but-undelivered Hotmail invites look fine.
RESEND_WEBHOOK_SECRET=

# DEPRECATED — single-tenant leftover, dev fallback for the ablute_ org ONLY.
# Investor outreach in the multi-tenant product must send from either the
# founder's own mailbox (per-user OAuth, IRM_SPEC §8d) or, at minimum, the
# org's own sender_email verified in Resend — never from a global env var.
# Do not read these for outreach sends in new code.
SENDER_EMAIL=nunomarujo@ablute.pt
BCC_EMAIL=investors@ablute.pt

# --- Billing (Stripe subscriptions, env-gated) ---
# Billing stays dark until ALL of these are set (stripeConfigured()); the Plans
# page then swaps its request-to-back-office CTA for real checkout + portal.
# Apply migration 0031 before setting these (the webhook writes orgs.stripe_*).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GARAGE_MONTHLY=
STRIPE_PRICE_GARAGE_ANNUAL=
STRIPE_PRICE_MOTHERFUNDING_MONTHLY=
STRIPE_PRICE_MOTHERFUNDING_ANNUAL=

# Investor-side billing (Prompt 501) — a SEPARATE gate
# (investorBillingConfigured()) from the four founder prices above, on
# purpose: neither side can switch the other off. The investor Plans page
# keeps its request-to-back-office fallback until all six of these are set.
# Apply migration 0287 before setting them (the webhook writes investor_billing).
# Shares STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET above (same Stripe account,
# same webhook endpoint).
STRIPE_PRICE_PRO_SCOUT_MONTHLY=
STRIPE_PRICE_PRO_SCOUT_ANNUAL=
STRIPE_PRICE_ACE_SPOTTER_MONTHLY=
STRIPE_PRICE_ACE_SPOTTER_ANNUAL=
STRIPE_PRICE_LEGENDARY_SLEUTH_MONTHLY=
STRIPE_PRICE_LEGENDARY_SLEUTH_ANNUAL=

# --- AI Review (Phase 4, paid feature) ---
ANTHROPIC_API_KEY=
AI_REVIEW_MODEL=claude-sonnet-4-5
# Prompt 208 D.2 -- modelo para classificar respostas recebidas. Proprio, e
# nao o AI_REVIEW_MODEL: classificar um email sao centenas de tokens, nao
# milhares. Fora da quota Watson; o gate e a ANTHROPIC_API_KEY acima.
AI_CLASSIFY_MODEL=claude-haiku-4-5

# --- Gmail OAuth pairing (IRM_SPEC §8d) ---
# Create an OAuth client (Web application) in Google Cloud Console; add
# https://<your-domain>/api/oauth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte key, base64-encoded, for encrypting stored OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Contact & Support ---
# Where /api/support/submit sends a notification (via Resend) for every new
# ticket. Never hard-code the address in code — read this var only.
SUPPORT_NOTIFY_EMAIL=

# --- Vault upload security (Prompt 301 §3) ---
# Malware scanning for Vault uploads via VirusTotal's public API. Without
# this, uploads still go through the magic-byte allowlist (always active,
# no key needed) but every file's malware_scan_status stays 'pending'
# forever — no malware coverage at all until this is set. Get a free key at
# https://www.virustotal.com/gui/my-apikey (rate-limited; fine for this scale).
VIRUSTOTAL_API_KEY=

# --- Investor self-claim (IRM_SPEC §5) ---
# Set to "true" once the Supabase LinkedIn OIDC provider is configured, to
# turn on the "Claim your profile" flow in the investor portal. Until then
# it shows an explanatory message instead. GDPR/RGPD requests do NOT need
# this — see /privacy-request, which works unconditionally.
NEXT_PUBLIC_LINKEDIN_OAUTH_ENABLED=
